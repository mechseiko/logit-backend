# ---------------------------------------------------------------------------
# LOGIT backend environment. Copy to .env for local use. NEVER commit secrets.
# With this file absent, the API runs fully in mock mode:
#   dev auth, in-memory store, local disk storage, mock AI, mock payments.
# ---------------------------------------------------------------------------

# --- API core --------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Public URL of the API (used for local signed file links and callbacks)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the web app (referral links, Paystack callback)
APP_URL=http://localhost:5173
# Comma separated browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=debug

# Where local storage, the dev database snapshot and temp files live
DATA_DIR=.data

# --- Auth ------------------------------------------------------------------
# firebase = verify Firebase ID tokens, dev = local email sign-in (never in production)
AUTH_MODE=dev
# Secret used to sign local file URLs (set a long random value in production)
DEV_AUTH_SECRET=change-me-in-production
# Firebase service account JSON, one line. Required when AUTH_MODE=firebase.
FIREBASE_SERVICE_ACCOUNT_JSON=
# First admin: sign in with this Google email to become an admin
ADMIN_BOOTSTRAP_EMAIL=mechseiko@gmail.com

# --- Database --------------------------------------------------------------
# firestore (production) or memory (development/tests)
STORE_DRIVER=memory
# Snapshot the in-memory dev database to DATA_DIR/store.json
PERSIST_LOCAL_STORE=true
# Seeds the Nigerian school directory on first boot. No demo layouts are ever seeded;
# publish real templates through Admin -> Templates before launch.

# --- Storage (S3 compatible: Backblaze B2, Cloudflare R2 or MinIO) --------
# local = filesystem under DATA_DIR/storage, s3 = remote bucket
STORAGE_DRIVER=local
# Backblaze B2: https://s3.<region>.backblazeb2.com (e.g. us-east-005)
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=uselogit
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_BUDGET_BYTES=10737418240

# --- AI --------------------------------------------------------------------
# gemini or mock. Defaults to mock unless GEMINI_API_KEY is present.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Payments (Paystack) ---------------------------------------------------
# paystack or mock. Amounts are always computed on the server in kobo.
PAYMENTS_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Support/legal details are hardcoded in packages/shared/src/constants.ts.

# There is no mock/staging escape hatch: production refuses to boot with mock
# providers, dev auth, or local storage. Missing credentials = failed deploy.

# --- Retention and processing ---------------------------------------------
RETENTION_DAYS=14
ENTRIES_RETENTION_DAYS=180
MAX_CONCURRENT_JOBS=1
QUEUE_POLL_MS=3000
CLEANUP_INTERVAL_MS=3600000
# System PDF tools (installed in the Docker image; JS fallbacks run locally)
GHOSTSCRIPT_BIN=gs
PDFTOPPM_BIN=pdftoppm
PDFTOTEXT_BIN=pdftotext
PDFINFO_BIN=pdfinfo

# ---------------------------------------------------------------------------
